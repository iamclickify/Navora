# ── Data / Training Artifacts ───────────────────────────────────────────────
# These files are regenerated by ingestion/training scripts and should NOT
# be committed. Runtime-critical CSVs (historical_freight_data.csv,
# port_constraints.csv, raw/manual_reference/vessel_specs.csv) are kept.

# Intermediate feature engineering output (regenerated by build_features.py)
data/processed/model_features.csv

# Port congestion proxy (regenerated by generate_congestion_proxy.py)
data/processed/port_observations.csv

# Port specs for training congestion/weather ingestion (regenerated by validate_manual_references.py)
data/processed/port_specs.csv

# Historical weather used for model training (regenerated by fetch_weather.py)
data/all_ports_historical_weather.csv
